# === Обязательно для боевого режима ===
BOT_TOKEN=
WEBAPP_URL=https://your-domain.com

# Telegram API (my.telegram.org) — для автологина в маркеты
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=

# Токены маркетов (можно вручную из DevTools, если без Telethon)
MRKT_TOKEN=
PORTALS_TOKEN=
TONNEL_AUTH=

# Режим: true = демо-данные без токенов
DEMO_MODE=true

# Фильтры новичка по умолчанию
MAX_SELLER_LEVEL=1
MAX_SELLER_NFTS=2
MAX_PRICE_TON=

# Backend
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
